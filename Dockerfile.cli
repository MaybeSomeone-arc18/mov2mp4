# Optional headless CLI image. This does not package or test the desktop GUI.
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY converter.py convert.py logger.py runtime.py utils.py ./
ENTRYPOINT ["python", "convert.py"]
